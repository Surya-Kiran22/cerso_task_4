# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values. Never commit the real .env
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
APP_NAME=Student Management System API

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/student_management

# Auth
# Generate a strong secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# Comma separated list of origins allowed by CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Pagination
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100
